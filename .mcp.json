{
  "mcpServers": {
    "gemini-notebook-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.11",
        "--exclude-newer",
        "2026-10-03T00:00:00Z",
        "--from",
        "notebooklm-mcp-cli==0.15.1",
        "notebooklm-mcp"
      ],
      "env": {
        "NOTEBOOKLM_MCP_CLI_PATH": "${USERPROFILE}/.tvxd-notebooklm-mcp-cli",
        "NLM_PROFILE": "tvxd-m01",
        "NOTEBOOKLM_DISABLED_GROUPS": "notebooks_read,notebooks_manage,sources_read,sources_manage,chat,query_multi,organization,automation,notes,aliases,auth,server,usage,sharing,research,studio",
        "NOTEBOOKLM_ENABLED_TOOLS": "notebook_list,notebook_get,source_get_content,notebook_query"
      }
    }
  }
}
