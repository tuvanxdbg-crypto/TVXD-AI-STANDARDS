{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_rules.v1.json",
  "title": "CAD audit rules v1",
  "description": "Rule file (YAML, read with yaml.safe_load, then checked against this schema). docs/M04_CAD_AUDIT_READONLY.md D3. Closed check types, no free expressions.",
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "space": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "layer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "block_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": "Closed filter. Empty selector = every object of the group."
    },
    "check_name_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "field",
        "pattern"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "name_pattern"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "check_allowed_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "field",
        "values"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "allowed_values"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      }
    },
    "check_numeric_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "field"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "numeric_range"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "check_required_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "required_field"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "attribute_tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "check_equals_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "field_a",
        "field_b"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "equals_field"
        },
        "field_a": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "field_b": {
          "type": "string",
          "pattern": "^[a-z_]{1,32}$"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "check_xref_resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "xref_resolved"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "source",
        "applies_to",
        "selector",
        "check",
        "standard_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": [
            "FIXTURE",
            "PROPOSED",
            "APPROVED"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500,
          "description": "Where the rule was approved (internal source). null = no internal source."
        },
        "applies_to": {
          "type": "string",
          "enum": [
            "layers",
            "blocks",
            "block_refs",
            "attributes",
            "texts",
            "dimensions",
            "xrefs",
            "units"
          ]
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "check": {
          "oneOf": [
            {
              "$ref": "#/$defs/check_name_pattern"
            },
            {
              "$ref": "#/$defs/check_allowed_values"
            },
            {
              "$ref": "#/$defs/check_numeric_range"
            },
            {
              "$ref": "#/$defs/check_required_field"
            },
            {
              "$ref": "#/$defs/check_equals_field"
            },
            {
              "$ref": "#/$defs/check_xref_resolved"
            }
          ]
        },
        "standard_required": {
          "type": "boolean"
        },
        "standard_hint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,63}$",
          "description": "Suggested document code, not a citation."
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rules_version",
    "rules"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "tvxd.cadaudit.rules/v1"
    },
    "rules_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "fixture_note": {
      "type": "string",
      "maxLength": 1000
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  }
}
