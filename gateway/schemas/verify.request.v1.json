{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verify.request.v1.json",
  "title": "standards_verify request v1",
  "type": "object",
  "additionalProperties": false,
  "description": "Re-check source identity, version, hash, mapping and INDEX applicability of evidence. Does not certify design compliance or legal validity.",
  "anyOf": [
    {
      "required": [
        "evidence"
      ]
    },
    {
      "required": [
        "evidence_id"
      ]
    }
  ],
  "properties": {
    "evidence": {
      "type": "object",
      "description": "An evidence object previously returned by standards_lookup."
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev_[0-9a-f]{24}$"
    },
    "work_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "project_context": {
      "$ref": "common.v1.json#/$defs/project_context"
    }
  }
}
