{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.v1.json",
  "title": "Shared definitions v1",
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "INDEX_INVALID",
            "SOURCE_NOT_ALLOWED",
            "SOURCE_NOT_FOUND",
            "CLAUSE_AMBIGUOUS",
            "CITED_SOURCE_NOT_WHITELISTED",
            "VERSION_AMBIGUOUS",
            "SOURCE_DRIFT",
            "APPLICABILITY_UNKNOWN",
            "BACKEND_UNAVAILABLE",
            "AUTH_REQUIRED",
            "TIMEOUT",
            "UNSUPPORTED_FORMAT",
            "EXTRACTION_FAILED",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "missing"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ],
          "description": "Derived only from INDEX metadata and the request context; never a legal or design conclusion."
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Inputs that would let the Gateway decide (empty when decided)."
        }
      }
    },
    "index_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_version",
        "rules_version",
        "index_sha256",
        "fixture"
      ],
      "properties": {
        "index_version": {
          "type": "string"
        },
        "rules_version": {
          "type": "string"
        },
        "index_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fixture": {
          "type": "boolean"
        }
      }
    },
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "maxLength": 128
        },
        "conditions": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Owner/engineer answers to INDEX applicability condition ids, e.g. {\"COND-INDOOR\": true}."
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "work_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "detail": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
