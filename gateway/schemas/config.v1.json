{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.v1.json",
  "title": "Gateway config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "index_path"
  ],
  "properties": {
    "schema": {
      "const": "tvxd.gateway.config/v1",
      "type": "string"
    },
    "index_path": {
      "type": "string",
      "minLength": 1
    },
    "source_root": {
      "type": "string",
      "minLength": 1,
      "description": "Optional since contract v2 (M02_NOTEBOOKLM_PRIMARY_TRUSTED_SOURCE): the Gateway lookup/verify/status flow no longer reads local files."
    },
    "notebooklm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "disabled",
            "mcp_stdio"
          ],
          "description": "disabled (default). mcp_stdio launches the M01 gated server; not authorized before the live-pilot review."
        },
        "mcp_config": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "timeout_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "total_budget_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 1800
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "ttl_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000,
          "description": "Lifetime of a cached lookup in seconds (default 3600); 0 disables caching."
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 209715200
        },
        "max_excerpt_chars": {
          "type": "integer",
          "minimum": 200,
          "maximum": 100000
        },
        "max_docx_uncompressed_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 524288000
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ]
        }
      }
    }
  }
}
